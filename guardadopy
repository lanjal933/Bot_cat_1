def extraer_ids(texto):

    ids = []

    partes = texto.split()

    for parte in partes:

        if parte.startswith("<@"):

            limpio = (
                parte
                .replace("<@", "")
                .replace("!", "")
                .replace(">", "")
            )

            if limpio.isdigit():
                ids.append(limpio)

    return ids
