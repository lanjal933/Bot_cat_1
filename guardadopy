@bot.tree.command(
    name="sumar_xp",
    description="Dar experiencia a un personaje"
)

@app_commands.describe(
    jugador="Jugador dueño del personaje",
    nick_pj="Nick del personaje",
    cantidad="Cantidad de XP"
)

@app_commands.checks.has_role("Staff")

async def sumar_xp(
    interaction: discord.Interaction,
    jugador: discord.Member,
    nick_pj: str,
    cantidad: int
):

    data = load_data()

    user_id = str(jugador.id)

    nick_pj = nick_pj.lower()

    pj = get_pj(data, user_id, nick_pj)

    if not pj:
        await interaction.response.send_message(
            "❌ Personaje no encontrado.",
            ephemeral=True
        )
        return

    # Seguridad
    pj.setdefault("xp", 0)
    pj.setdefault("nivel", 1)

    nivel_anterior = pj["nivel"]

    # Agregar XP
    pj["xp"] += cantidad

    # Calcular nuevo nivel
    nuevo_nivel = calcular_nivel(pj["xp"])

    pj["nivel"] = nuevo_nivel

    save_data(data)

    mensaje = (
        f"✨ `{nick_pj}` recibió **{cantidad} XP**\n"
        f"📚 XP total: **{pj['xp']}**"
    )

    if nuevo_nivel > nivel_anterior:

        mensaje += (
            f"\n\n🎉 SUBIÓ DE NIVEL\n"
            f"⬆ {nivel_anterior} ➜ {nuevo_nivel}"
        )

    await interaction.response.send_message(mensaje)    

