@app_commands.checks.has_role("Staff")
@bot.tree.command(name="registrar_pj", description="Registrar un nuevo personaje")

@app_commands.describe(
    usuario="Dueño del personaje",
    nick_pj="Nick único del personaje",
    nombre="Nombre del personaje",
    clase="Clase",
    nivel="Nivel",
    edad="Edad",
    estatura="Estatura",
    frase="Frase frecuente",
    link="Link del personaje"
)

async def registrar_pj(
    interaction: discord.Interaction,
    usuario: discord.User,
    nick_pj: str,
    nombre: str,
    clase: str,
    nivel: int,
    edad: str,
    estatura: str,
    frase: str,
    link: str
):

    data = load_data()

    user_id = str(usuario.id)

    # Normalizar nick
    nick_pj = nick_pj.lower()

    # Crear usuario si no existe
    if user_id not in data:
        data[user_id] = {
            "personajes": {}
        }

    personajes = data[user_id]["personajes"]

    # Verificar si ya existe
    if nick_pj in personajes:

        await interaction.response.send_message(
            f"❌ Ya existe un personaje con el nick `{nick_pj}`",
            ephemeral=True
        )
        return

    # Crear personaje
    personajes[nick_pj] = {

        "nombre": nombre,
        "clase": clase,
        "nivel": nivel,

        "xp": 0,
        "blines": 0,

        "edad": edad,
        "estatura": estatura,
        "frase": frase,
        "link": link,

        "inventario": [],
        "Añadidos": []
    }

    save_data(data)

    await interaction.response.send_message(

        f"✅ PJ **{nombre}** creado correctamente.\n"
        f"👤 Dueño: {usuario.mention}\n"
        f"🆔 Nick: `{nick_pj}`"

    )

    print("✅ PERSONAJE REGISTRADO")
    print(data)

