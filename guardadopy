    usuario="Jugador",
    nick_pj="Nick del personaje"
)

@bot.tree.command(
    name="subir_nivel",
    description="Subir manualmente un nivel"
)

@app_commands.checks.has_role("Staff")

async def subir_nivel(
    interaction: discord.Interaction,
    usuario: discord.User,
    nick_pj: str
):

    data = load_data()

    user_id = str(usuario.id)

    nick_pj = nick_pj.lower()

    pj = get_pj(data, user_id, nick_pj)

    if not pj:
        await interaction.response.send_message(
            "❌ PJ no encontrado",
            ephemeral=True
        )
        return

    nivel_anterior = pj.get("nivel", 1)

    if nivel_anterior >= 20:

        await interaction.response.send_message(
            "❌ Ya alcanzó el nivel máximo.",
            ephemeral=True
        )
        return

    pj["nivel"] += 1

    save_data(data)

    embed = discord.Embed(
        title="✨ Subida Manual de Nivel",
        color=discord.Color.green()
    )

    embed.add_field(
        name="Personaje",
        value=pj["nombre"]
    )

    embed.add_field(
        name="Nivel anterior",
        value=nivel_anterior
    )

    embed.add_field(
        name="Nuevo nivel",
        value=pj["nivel"]
    )

    await interaction.response.send_message(embed=embed)
